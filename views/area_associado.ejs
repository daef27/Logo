<%- include('partials/header', { title: 'Meu Painel - ' + associado.nome + ' - ASSGA', active_page: 'area_associado' }) %>

<div class="container py-3">
    <!-- Header do Associado -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-white" style="background: linear-gradient(135deg, #003366 0%, #004aad 100%);">
        <div class="d-flex flex-wrap align-items-center gap-4">
            <img src="<%= associado.foto_url %>" alt="<%= associado.nome %>" class="rounded-circle border border-4 border-warning shadow" style="width: 90px; height: 90px; object-fit: cover;">
            <div class="flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h3 class="fw-bold mb-0 text-white"><%= associado.nome %></h3>
                    <span class="badge bg-warning text-dark fw-bold"><%= associado.categoria %></span>
                    <span class="badge <%= associado.status === 'Ativo' ? 'bg-success' : 'bg-danger' %>"><%= associado.status %></span>
                </div>
                <div class="text-light opacity-90 small mt-1">
                    <span class="me-3"><i class="fa-solid fa-id-badge text-warning me-1"></i> Matrícula: <strong><%= associado.matricula %></strong></span>
                    <span class="me-3"><i class="fa-solid fa-envelope text-warning me-1"></i> <%= associado.email %></span>
                    <span><i class="fa-solid fa-phone text-warning me-1"></i> <%= associado.telefone %></span>
                </div>
            </div>
            <div>
                <a href="/carteirinha" class="btn btn-warning fw-bold px-3 py-2 shadow-sm" id="btn-painel-carteirinha">
                    <i class="fa-solid fa-id-card me-2"></i> Minha Carteirinha
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Dados Cadastrais -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user-gear me-2 text-warning"></i>Dados Cadastrais</h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">CPF</span>
                        <span class="fw-semibold"><%= associado.cpf %></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">RG</span>
                        <span class="fw-semibold"><%= associado.rg || "Não informado" %></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Data de Nascimento</span>
                        <span class="fw-semibold"><%= associado.data_nascimento %></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Identidade</span>
                        <span class="fw-semibold text-primary"><%= associado.identidade_surda %></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Cidade / Estado</span>
                        <span class="fw-semibold"><%= associado.cidade %> - <%= associado.estado %></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Data de Filiação</span>
                        <span class="fw-semibold"><%= associado.data_filiacao %></span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted">Validade da Carteirinha</span>
                        <span class="fw-bold text-success"><%= associado.validade_carteirinha %></span>
                    </li>
                </ul>

                <div class="mt-4 pt-3 border-top">
                    <a href="https://wa.me/5584996981248?text=Ol%C3%A1%2C%20sou%20o%20associado%20<%= encodeURIComponent(associado.nome) %>%20e%20gostaria%20de%20atualizar%20meus%20dados%20cadastrais" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="fa-solid fa-pen me-1"></i> Solicitar Atualização de Dados
                    </a>
                </div>
            </div>
        </div>

        <!-- Histórico de Mensalidades -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-receipt me-2 text-warning"></i>Mensalidades e Contribuições</h5>
                    <a href="/pagamento" class="btn btn-sm btn-outline-success fw-bold">
                        <i class="fa-brands fa-pix me-1"></i> Pagar Mensalidade
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Referência</th>
                                <th>Valor</th>
                                <th>Status</th>
                                <th>Método</th>
                                <th>Data Pagamento</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof mensalidades !== 'undefined' && mensalidades.length > 0) { %>
                                <% for (const m of mensalidades) { %>
                                    <tr>
                                        <td class="fw-bold"><%= String(m.mes_referencia).padStart(2, '0') %>/<%= m.ano_referencia %></td>
                                        <td>R$ <%= m.valor.toFixed(2).replace('.', ',') %></td>
                                        <td>
                                            <% if (m.status === 'Pago') { %>
                                                <span class="badge bg-success">Pago</span>
                                            <% } else if (m.status === 'Pendente') { %>
                                                <span class="badge bg-warning text-dark">Pendente</span>
                                            <% } else { %>
                                                <span class="badge bg-info text-dark"><%= m.status %></span>
                                            <% } %>
                                        </td>
                                        <td><%= m.metodo %></td>
                                        <td><%= m.data_pagamento || '-' %></td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Nenhum registro de mensalidade encontrado.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <div class="p-3 bg-light rounded-3 mt-4 border">
                    <h6 class="fw-bold text-primary small mb-1"><i class="fa-solid fa-shield-halved me-1"></i> Validação Eletrônica de Carteirinha</h6>
                    <p class="small text-muted mb-0">
                        Sua carteirinha possui QR Code exclusivo auditável por qualquer autoridade esportiva, clube ou estabelecimento conveniado.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
