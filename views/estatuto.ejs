<%- include('partials/header', { title: 'Estatuto Social - ASSGA', active_page: 'estatuto' }) %>

<div class="container py-3">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold text-uppercase">Documento Oficial</span>
                <h2 class="fw-bold text-primary mt-2 mb-0">Estatuto Social da ASSGA</h2>
                <p class="text-muted small mb-0">Regulamento Interno e Normas da Associação</p>
            </div>
            <div class="mt-3 mt-md-0">
                <form method="get" action="/estatuto" class="d-flex gap-2">
                    <input type="text" name="q" value="<%= typeof busca !== 'undefined' ? busca : '' %>" class="form-control" placeholder="Buscar artigo ou palavra-chave..." aria-label="Buscar artigo">
                    <button type="submit" class="btn btn-primary" aria-label="Buscar"><i class="fa-solid fa-search"></i></button>
                    <% if (typeof busca !== 'undefined' && busca) { %>
                        <a href="/estatuto" class="btn btn-outline-secondary">Limpar</a>
                    <% } %>
                </form>
            </div>
        </div>

        <% if (typeof busca !== 'undefined' && busca) { %>
            <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
                <div>
                    <i class="fa-solid fa-magnifying-glass me-2"></i> Resultados da busca por: <strong>"<%= busca %>"</strong> (<%= artigos_filtrados.length %> artigos encontrados)
                </div>
                <a href="/estatuto" class="btn btn-sm btn-outline-primary">Ver Estatuto Completo</a>
            </div>
            <div class="row g-3">
                <% if (artigos_filtrados && artigos_filtrados.length > 0) { %>
                    <% for (const artigo of artigos_filtrados) { %>
                        <div class="col-12">
                            <div class="card border-0 bg-light p-3 rounded-3 shadow-sm">
                                <h6 class="fw-bold text-primary mb-2"><%= artigo.capitulo_nome %> - Artigo <%= artigo.numero %>º</h6>
                                <p class="mb-2 text-dark leading-relaxed"><%= artigo.texto %></p>
                                <% if (artigo.paragrafo_unico) { %>
                                    <div class="p-2 bg-white rounded border-start border-3 border-warning small text-secondary">
                                        <strong>Parágrafo Único:</strong> <%= artigo.paragrafo_unico %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="col-12 text-center py-4 text-muted">
                        <i class="fa-solid fa-file-circle-xmark fs-2 text-secondary mb-2 d-block"></i>
                        Nenhum artigo encontrado com o termo pesquisado. Tente buscar por "LIBRAS", "sócio", "direitos" ou "finalidade".
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="accordion" id="accordionEstatuto">
                <% if (typeof capitulos !== 'undefined' && capitulos.length > 0) { %>
                    <% capitulos.forEach((cap, index) => { %>
                        <div class="accordion-item border-0 mb-3 rounded-3 overflow-hidden shadow-sm">
                            <h2 class="accordion-header" id="heading<%= cap.id %>">
                                <button class="accordion-button <%= index !== 0 ? 'collapsed' : '' %> bg-light fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= cap.id %>" aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
                                    <i class="fa-solid fa-bookmark text-warning me-2"></i> Capítulo <%= cap.numero %>: <%= cap.titulo %>
                                </button>
                            </h2>
                            <div id="collapse<%= cap.id %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" data-bs-parent="#accordionEstatuto">
                                <div class="accordion-body bg-white">
                                    <% if (cap.artigos && cap.artigos.length > 0) { %>
                                        <% cap.artigos.forEach((artigo, aIndex) => { %>
                                            <div class="mb-3 pb-3 <%= aIndex !== cap.artigos.length - 1 ? 'border-bottom' : '' %>">
                                                <h6 class="fw-bold text-dark mb-1">Art. <%= artigo.numero %>º</h6>
                                                <p class="mb-1 text-secondary leading-relaxed"><%= artigo.texto %></p>
                                                <% if (artigo.paragrafo_unico) { %>
                                                    <div class="p-2 bg-light rounded text-muted small mt-2 border-start border-3 border-warning">
                                                        <strong>Parágrafo Único:</strong> <%= artigo.paragrafo_unico %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-muted small mb-0">Artigos deste capítulo em fase de consolidação.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        <% } %>

        <div class="mt-4 p-3 bg-light rounded-3 text-center small text-muted">
            <i class="fa-solid fa-scale-balanced me-1 text-primary"></i> Estatuto aprovado na Assembleia Geral de Fundação em São Gonçalo do Amarante - RN.
        </div>
    </div>
</div>

<%- include('partials/footer') %>
