<%- include('partials/header', { title: 'Carteirinha Oficial do Associado - ASSGA', active_page: 'carteirinha' }) %>

<style>
    .carteirinha-frente, .carteirinha-verso {
        width: 350px;
        height: 220px;
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 51, 102, 0.2);
    }
    .carteirinha-frente {
        background: linear-gradient(135deg, #003366 0%, #004aad 100%);
        color: white;
        border: 2px solid #c62828;
    }
    .carteirinha-verso {
        background: #ffffff;
        color: #003366;
        border: 2px solid #004aad;
    }
    .foto-carteirinha {
        width: 75px;
        height: 95px;
        object-fit: cover;
        border-radius: 6px;
        border: 2px solid #ffc107;
    }
    .qr-container {
        width: 72px;
        height: 72px;
        background: white;
        padding: 4px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    @media print {
        header, footer, nav, .no-print, .alert, .btn, .accessibility-bar, .ai-assistant-btn, #assistantModal {
            display: none !important;
        }
        body {
            background: white !important;
            padding: 0 !important;
        }
        .carteirinha-container {
            margin: 0 !important;
            page-break-inside: avoid;
        }
    }
</style>

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 no-print border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="fa-solid fa-id-card me-2 text-warning"></i>Carteirinha Oficial de Sócio</h2>
            <p class="text-muted mb-0">Documento oficial de identificação do associado ASSGA</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <button onclick="window.print()" class="btn btn-primary fw-bold px-3 shadow-sm" id="btn-print-carteirinha">
                <i class="fa-solid fa-print me-2"></i> Imprimir Carteirinha
            </button>
            <% if (typeof associadoLogado !== 'undefined' && associadoLogado) { %>
                <a href="/area-associado" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Voltar ao Painel
                </a>
            <% } else { %>
                <a href="/login" class="btn btn-outline-primary">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Entrar com Minha Matrícula
                </a>
            <% } %>
        </div>
    </div>

    <% if (typeof outrosAssociados !== 'undefined' && outrosAssociados && outrosAssociados.length > 1) { %>
        <div class="card border-0 bg-light p-3 rounded-4 mb-4 no-print shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="small fw-bold text-secondary">
                    <i class="fa-solid fa-users me-1 text-primary"></i> Alternar Associado em Demonstração:
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% for (const a of outrosAssociados) { %>
                        <a href="/carteirinha/<%= a.matricula %>" class="btn btn-sm <%= a.id === associado.id ? 'btn-primary' : 'btn-outline-secondary' %>">
                            <%= a.nome.split(' ')[0] %> (<%= a.matricula %>)
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Container da Carteirinha (Frente e Verso) -->
    <div class="row justify-content-center g-4 carteirinha-container mb-5">
        <!-- FRENTE -->
        <div class="col-auto">
            <h6 class="text-center text-muted small fw-bold mb-2 no-print">FRENTE</h6>
            <div class="carteirinha-frente p-3 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-1">
                    <div>
                        <div class="fw-bold fs-5 text-warning" style="letter-spacing: 1px;">ASSGA</div>
                        <div style="font-size: 7.5px; opacity: 0.95; letter-spacing: 0.2px;">ASSOCIAÇÃO DE SURDOS DE SÃO GONÇALO DO AMARANTE</div>
                    </div>
                    <span class="badge bg-warning text-dark px-2 py-1 fw-bold" style="font-size: 9px;">OFICIAL</span>
                </div>

                <div class="d-flex gap-3 align-items-center my-auto">
                    <img src="<%= associado.foto_url %>" alt="<%= associado.nome %>" class="foto-carteirinha shadow-sm">
                    <div style="font-size: 11px;">
                        <div class="fw-bold text-truncate text-white" style="max-width: 210px; font-size: 12px;"><%= associado.nome %></div>
                        <div class="text-warning fw-semibold mt-1">Matrícula: <%= associado.matricula %></div>
                        <div class="opacity-90">CPF: <%= associado.cpf %></div>
                        <div class="opacity-90">Categoria: <%= associado.categoria %></div>
                        <div class="opacity-90">Identidade: <%= associado.identidade_surda %></div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top border-warning pt-1" style="font-size: 9px;">
                    <div>Validade: <strong class="text-warning"><%= associado.validade_carteirinha %></strong></div>
                    <div class="text-uppercase fw-bold text-warning">Status: <%= associado.status %></div>
                </div>
            </div>
        </div>

        <!-- VERSO -->
        <div class="col-auto">
            <h6 class="text-center text-muted small fw-bold mb-2 no-print">VERSO</h6>
            <div class="carteirinha-verso p-3 d-flex flex-column justify-content-between">
                <div class="text-center border-bottom pb-1">
                    <div class="fw-bold text-primary" style="font-size: 9.5px;">ASSOCIAÇÃO DOS SURDOS DE SÃO GONÇALO DO AMARANTE</div>
                    <div class="text-muted" style="font-size: 7.5px;">CNPJ: 57.242.499/0001-60 | São Gonçalo do Amarante - RN</div>
                </div>

                <div class="d-flex justify-content-between align-items-center my-auto px-1" style="font-size: 10px;">
                    <div>
                        <div><strong>Data Nasc:</strong> <%= associado.data_nascimento %></div>
                        <div><strong>Tipo Sanguíneo:</strong> <%= associado.tipo_sanguineo || 'O+' %></div>
                        <div><strong>Filiação:</strong> <%= associado.data_filiacao %></div>
                        <div><strong>Via:</strong> <%= carteirinha ? carteirinha.via : 1 %>ª Via</div>
                    </div>
                    <div class="text-center">
                        <div class="qr-container border shadow-sm mx-auto">
                            <!-- QR Code para Validação Oficial -->
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=https://assga-portal.app/validar/<%= carteirinha ? carteirinha.codigo_autenticacao : 'ASSGA-SAMPLE' %>" alt="QR Code" style="width: 100%; height: 100%;">
                        </div>
                        <div class="text-muted mt-1" style="font-size: 7px; font-weight: 600;">Validação Digital</div>
                    </div>
                </div>

                <div class="border-top pt-1 text-center" style="font-size: 8px; color: #004aad;">
                    <div>Código Único de Segurança: <span class="font-monospace text-dark fw-bold"><%= carteirinha ? carteirinha.codigo_autenticacao : 'ASSGA-AUTH-000' %></span></div>
                    <div>Este documento é pessoal e intransferível. Acessível em LIBRAS.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orientações de Impressão -->
    <div class="card border-0 bg-light p-4 rounded-4 shadow-sm no-print">
        <h5 class="fw-bold text-primary mb-2"><i class="fa-solid fa-circle-info me-2 text-warning"></i>Instruções para Impressão e Plastificação</h5>
        <ul class="text-secondary small mb-0 leading-relaxed">
            <li>Recomendamos imprimir em papel fotográfico fosco ou glossy de gramatura 180g ou superior para máxima durabilidade.</li>
            <li>Recorte no limite das bordas arredondadas e una frente e verso antes de plastificar ou inserir em porta-crachá transparente.</li>
            <li>O QR Code pode ser escaneado por qualquer câmera de smartphone para comprovar instantaneamente a validade da filiação do associado.</li>
        </ul>
    </div>
</div>

<%- include('partials/footer') %>
