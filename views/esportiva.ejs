<%- include('partials/header', { title: 'Departamento Esportivo - ASSGA', active_page: 'esportiva' }) %>

<div class="container py-3">
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase shadow-sm">
            <i class="fa-solid fa-trophy me-1"></i> Desporto de Surdos
        </span>
        <h2 class="fw-bold text-primary mt-2">Modalidades Esportivas ASSGA</h2>
        <p class="text-muted">Filiada à CBDS e FENEIS: promovendo saúde, integração e alto rendimento para surdoatletas.</p>
    </div>

    <div class="row g-4 mb-5">
        <% if (typeof modalidades !== 'undefined' && modalidades.length > 0) { %>
            <% for (const mod of modalidades) { %>
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-shadow">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-primary text-warning rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px; min-width: 56px;">
                                <i class="fa-solid <%= mod.icone %> fs-4"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-0"><%= mod.nome %></h4>
                                <span class="badge bg-light text-primary border"><%= mod.categoria %></span>
                            </div>
                        </div>

                        <p class="text-secondary mb-3 leading-relaxed"><%= mod.descricao %></p>

                        <div class="bg-light p-3 rounded-3 small mt-auto border">
                            <div class="mb-1"><strong><i class="fa-solid fa-clock text-primary me-2"></i>Horários:</strong> <%= mod.dias_treino %></div>
                            <div class="mb-1"><strong><i class="fa-solid fa-location-dot text-danger me-2"></i>Local:</strong> <%= mod.local_treino %></div>
                            <div><strong><i class="fa-solid fa-user-tie text-success me-2"></i>Responsável Técnico:</strong> <%= mod.responsavel %></div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% } %>
    </div>

    <!-- Banner de Inscrição Esportiva -->
    <div class="p-4 rounded-4 shadow-sm text-white text-center" style="background: linear-gradient(135deg, #003366 0%, #004aad 100%);">
        <h4 class="fw-bold mb-2 text-warning"><i class="fa-solid fa-medal me-2"></i>Quer treinar e competir pela ASSGA?</h4>
        <p class="small text-light opacity-90 mb-3 mx-auto" style="max-width: 680px;">
            Associados ativos possuem acesso aos treinamentos regulares, uniformes e participação nas seletivas para os campeonatos estaduais e nacionais da CBDS.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a href="https://wa.me/5584996981248" target="_blank" rel="noopener noreferrer" class="btn btn-warning fw-bold px-4 py-2 shadow-sm">
                <i class="fa-brands fa-whatsapp me-2"></i> Falar com a Diretoria de Esportes
            </a>
            <a href="/carteirinha" class="btn btn-outline-light px-4 py-2 fw-semibold">
                Emitir Carteirinha de Atleta
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
