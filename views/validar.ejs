<%- include('partials/header', { title: 'Validação Eletrônica de Carteirinha - ASSGA', active_page: 'validar' }) %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center">
                <% if (typeof valida !== 'undefined' && valida && associado) { %>
                    <div class="text-success display-4 mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h3 class="fw-bold text-success mb-2">Carteirinha Válida e Autêntica</h3>
                    <p class="text-muted small mb-4">Registro verificado com sucesso na base de dados oficial da ASSGA.</p>

                    <div class="bg-light p-4 rounded-4 text-start small mb-4 border shadow-sm">
                        <div class="mb-2"><strong>Associado:</strong> <%= associado.nome %></div>
                        <div class="mb-2"><strong>Matrícula:</strong> <span class="badge bg-primary"><%= associado.matricula %></span></div>
                        <div class="mb-2"><strong>Categoria:</strong> <%= associado.categoria %></div>
                        <div class="mb-2"><strong>Identidade:</strong> <%= associado.identidade_surda %></div>
                        <div class="mb-2"><strong>Validade:</strong> <span class="text-success fw-bold"><%= associado.validade_carteirinha %></span></div>
                        <div class="mb-2"><strong>Status do Sócio:</strong> <span class="badge <%= associado.status === 'Ativo' ? 'bg-success' : 'bg-danger' %>"><%= associado.status %></span></div>
                        <div class="mb-0 text-muted"><strong>Autenticação:</strong> <span class="font-monospace text-dark fw-bold"><%= carteirinha ? carteirinha.codigo_autenticacao : '' %></span></div>
                    </div>
                <% } else { %>
                    <div class="text-danger display-4 mb-3">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                    <h3 class="fw-bold text-danger mb-2">Carteirinha Pendente, Vencida ou Não Encontrada</h3>
                    <p class="text-muted small mb-4">Não foi possível validar este documento. O associado precisa regularizar sua situação junto à secretaria da ASSGA.</p>

                    <div class="bg-light p-4 rounded-4 text-start small mb-4 border">
                        <div class="mb-2"><strong>Código Consultado:</strong> <span class="font-monospace"><%= typeof codigo !== 'undefined' ? codigo : 'Nenhum' %></span></div>
                        <div>Por favor, contate a secretaria da ASSGA via WhatsApp: (84) 99698-1248.</div>
                    </div>
                <% } %>

                <div class="text-muted small">
                    Consulta realizada em <%= new Date().toLocaleDateString('pt-BR') %> às <%= new Date().toLocaleTimeString('pt-BR') %>.
                    <br>
                    <strong>ASSGA - Associação de Surdos de São Gonçalo do Amarante / RN</strong>
                    <br>
                    <span class="text-secondary">CNPJ: 57.242.499/0001-60</span>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <a href="/" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-house me-1"></i> Voltar ao Portal ASSGA
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
